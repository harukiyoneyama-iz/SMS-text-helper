# サプライチェーン対策（必須）
# CLAUDE.md および templates/manifest.yml の `must.npmrc` と一致させること

# npm 11.10+ 用（日単位、7日未満のパッケージをブロック）
# npm 10.x では無視される（互換性のため両方記載）
min-release-age=7

# pnpm 用（分単位、7日 = 10080分）
minimum-release-age=10080

# postinstall などのライフサイクルスクリプトを無効化し、
# インストール時の任意コード実行を防ぐ
# ネイティブモジュール（sharp, bcrypt 等）が必要な場合は
# 個別に `npm rebuild <pkg> --scripts` で許可
ignore-scripts=true
