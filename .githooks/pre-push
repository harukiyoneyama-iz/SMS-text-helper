#!/bin/bash
# guideline pre-push hook: push 前に gitleaks で履歴差分の秘密情報をスキャン
#
# 動作:
#   - これから push される範囲（remote ref → local ref）を gitleaks で精査
#   - 検出されたら push 中断
#   - gitleaks 未インストールなら fail-closed で push 中断
#
# 緊急回避（非推奨）:
#   git push --no-verify

set -euo pipefail

# 標準入力から push 範囲を受け取る形式:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# 1 行ずつ複数 ref が来ることがある

if ! command -v gitleaks >/dev/null 2>&1; then
  {
    echo "⛔ gitleaks が見つかりません。push 前の秘密情報スキャンができないため push を中止しました。"
    echo "   導入してから再度 push してください:"
    echo "     Windows: scoop install gitleaks / choco install gitleaks"
    echo "     Mac:     brew install gitleaks"
    echo "   導入確認: gitleaks version"
  } >&2
  exit 1
fi

z40="0000000000000000000000000000000000000000"
HAS_LEAK=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$z40" ]; then
    # ブランチ削除 push はスキップ
    continue
  fi

  if [ "$remote_sha" = "$z40" ]; then
    # 新規ブランチの push: 直近 100 コミットだけ精査（履歴全部だと重い）
    range="${local_sha}~100..${local_sha}"
    if ! git rev-parse "$range" >/dev/null 2>&1; then
      range="$local_sha"
    fi
  else
    # 通常の push: remote_sha..local_sha
    # remote_sha がローカルに存在しないケース（pull 未実施で push 拒否される場面など）に対応
    if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
      echo "ℹ️  remote sha $remote_sha がローカルに無いので fetch を試みます..." >&2
      # remote_ref から remote 名を推測（refs/heads/main → origin が一般的）
      git fetch --quiet origin 2>/dev/null || true
    fi

    if git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
      range="${remote_sha}..${local_sha}"
    else
      # fetch 後も見つからない場合は local の差分だけ精査
      # （上流に追従していない可能性があるが、push する以上ローカル差分は必ず存在）
      echo "⚠️  remote sha を取得できず。ローカル直近のコミットのみ精査します。" >&2
      # 上流未追従の場合、直近 50 コミットを目安に精査
      range="${local_sha}~50..${local_sha}"
      if ! git rev-parse "$range" >/dev/null 2>&1; then
        range="$local_sha"
      fi
    fi
  fi

  echo "🔍 gitleaks: $range をスキャン中..." >&2
  if ! gitleaks detect --log-opts="$range" --redact --no-banner; then
    HAS_LEAK=1
  fi
done

if [ "$HAS_LEAK" -eq 1 ]; then
  {
    echo ""
    echo "⛔ push 範囲に秘密情報の疑いがあります。push を中断しました。"
    echo ""
    echo "対処:"
    echo "  1. 上記出力で該当コミット・ファイル・行を確認"
    echo "  2. 履歴から取り除く（git rebase -i / git filter-repo 等）"
    echo "  3. 漏洩した値が本物の秘密ならローテーションする"
    echo ""
    echo "緊急時のみ: git push --no-verify （非推奨。ログに残ります）"
  } >&2
  exit 1
fi

exit 0
